
<section id="quiz" style="padding:20px;background:#fff;border-radius:15px;margin:20px;box-shadow:0 2px 10px #ddd">
  <h2 style="color:#c91520;text-align:center">সাধারণ জ্ঞান কুইজ</h2>
  <p id="progress">প্রশ্ন ১ / ৫</p>
  <h3 id="question">প্রশ্ন এখানে আসবে</h3>
  <div id="answers"></div>
  <p id="feedback"></p>
  <h3 id="score"></h3>
  <button id="next" style="display:none;padding:12px 25px;background:#c91520;color:white;border:0;border-radius:8px" onclick="nextQuestion()">পরের প্রশ্ন</button>
  <button id="restart" style="display:none;padding:12px 25px;background:#c91520;color:white;border:0;border-radius:8px" onclick="startQuiz()">আবার খেলুন</button>
</section>

<style>
#quiz button.option {
  display:block;width:100%;padding:13px;margin:10px 0;
  background:#f4f4f4;border:1px solid #ddd;
  border-radius:8px;font-size:17px;text-align:left;
}
#quiz button.option:disabled {opacity:.8}
</style>

<script>
const questions = [
 {q:"বাংলাদেশের রাজধানী কোনটি?",a:["ঢাকা","চট্টগ্রাম","খুলনা","রাজশাহী"],c:0},
 {q:"বাংলাদেশের জাতীয় ফুল কোনটি?",a:["গোলাপ","শাপলা","জবা","বেলি"],c:1},
 {q:"বাংলাদেশের স্বাধীনতা দিবস কবে?",a:["১৬ ডিসেম্বর","২১ ফেব্রুয়ারি","২৬ মার্চ","১৪ এপ্রিল"],c:2},
 {q:"পৃথিবীর বৃহত্তম মহাসাগর কোনটি?",a:["আটলান্টিক","ভারত","প্রশান্ত","আর্কটিক"],c:2},
 {q:"বাংলাদেশের জাতীয় ফল কোনটি?",a:["আম","কাঁঠাল","লিচু","কলা"],c:1}
];

let current=0, points=0, answered=false;

function startQuiz(){
 current=0;points=0;answered=false;
 document.getElementById("restart").style.display="none";
 document.getElementById("score").innerText="";
 showQuestion();
}

function showQuestion(){
 answered=false;
 const q=questions[current];
 document.getElementById("progress").innerText="প্রশ্ন "+(current+1)+" / ৫";
 document.getElementById("question").innerText=q.q;
 document.getElementById("feedback").innerText="";
 document.getElementById("next").style.display="none";
 const box=document.getElementById("answers");
 box.innerHTML="";
 q.a.forEach((answer,i)=>{
  const b=document.createElement("button");
  b.className="option";
  b.innerText=answer;
  b.onclick=()=>checkAnswer(i,b);
  box.appendChild(b);
 });
}

function checkAnswer(i,button){
 if(answered)return;
 answered=true;
 const q=questions[current];
 const buttons=document.querySelectorAll("#answers button");
 buttons.forEach(b=>b.disabled=true);
 if(i===q.c){
  points+=10;
  document.getElementById("feedback").innerText="সঠিক উত্তর! +১০ পয়েন্ট";
  button.style.background="#c8f7c5";
 }else{
  document.getElementById("feedback").innerText="ভুল উত্তর! সঠিক উত্তর: "+q.a[q.c];
  button.style.background="#ffd5d5";
 }
 if(current<questions.length-1){
  document.getElementById("next").style.display="inline-block";
 }else{
  document.getElementById("score").innerText="আপনার মোট পয়েন্ট: "+points+" / ৫০";
  document.getElementById("restart").style.display="inline-block";
 }
}

function nextQuestion(){
 current++;
 showQuestion();
}

startQuiz();
</script>
